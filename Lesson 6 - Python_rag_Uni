def table_to_text(table, page_url):
    """Turn an HTML table into markdown rows like | 1 | [Oxford](link) | 100 |"""
    from urllib.parse import urljoin              # makes full links from short ones
    rows = []
    for tr in table.find_all("tr"):               # each row
        cells = []
        for cell in tr.find_all(["th", "td"]):    # each cell
            text = cell.get_text(" ", strip=True).replace("|", "/")  # the cell's text
            link = cell.find("a", href=True)      # is there a link in it?
            if link and text:
                text = f"[{text}]({urljoin(page_url, link['href'])})"  # keep the link
            cells.append(text)
        if any(cells):                            # skip empty rows
            rows.append("| " + " | ".join(cells) + " |")
    return "\n".join(rows)


def download_web_page(url, folder, session, follow, match):
    """Download a web page, keep its tables, and find links to follow. Returns (manifest_line, text, links)."""
    from bs4 import BeautifulSoup                 # reads HTML
    from urllib.parse import urljoin, urlparse    # works with links

    response = session.get(url, timeout=30)       # download it
    response.raise_for_status()                   # stop if the site said "error"
    page = BeautifulSoup(response.text, "lxml")   # read the HTML
    title = page.title.get_text(" ", strip=True) if page.title else url  # page title

    site = urlparse(url).netloc                   # e.g. www.ucas.com
    links = []                                    # links we'll follow
    if follow and match:                          # follow links that contain e.g. /courses/details/
        for a in page.find_all("a", href=True):
            link = urljoin(url, a["href"]).split("#")[0]
            if urlparse(link).netloc == site and match in urlparse(link).path and link not in links:
                links.append(link)

    for table in page.find_all("table"):          # every table on the page
        if follow and not match:                  # follow the links inside tables (e.g. each uni)
            for a in table.find_all("a", href=True):
                link = urljoin(url, a["href"]).split("#")[0]
                if urlparse(link).netloc == site and link != url and link not in links:
                    links.append(link)
        table.replace_with("\n\n" + table_to_text(table, url) + "\n\n")  # swap table for markdown

    for junk in page(["script", "style", "noscript", "nav", "footer", "header", "aside", "form"]):
        junk.decompose()                          # remove menus, adverts, code etc.
    text = page.get_text("\n", strip=True)        # the readable text
    text = re.sub(r"\n{3,}", "\n\n", text)[:MAX_PAGE_CHARS]  # tidy blank lines, cap the size
    line, text = save_page(folder, url, title, text)          # save it
    return line, text, links


def download_feed(url, folder, session):
    """Download a news feed and save each article as its own file. Returns manifest lines."""
    from bs4 import BeautifulSoup
    response = session.get(url, timeout=30)       # download the feed
    response.raise_for_status()
    feed = BeautifulSoup(response.content, "xml") # read it as XML
    site = feed.find("title").get_text(strip=True) if feed.find("title") else url  # feed name
    lines = []
    for item in feed.find_all(["item", "entry"])[:MAX_FEED_ITEMS]:   # each article
        title = item.find("title").get_text(" ", strip=True) if item.find("title") else url
        link_tag = item.find("link")
        link = (link_tag.get("href") or link_tag.get_text(strip=True)) if link_tag else url  # article link
        date_tag = item.find(["pubDate", "published", "updated"])
        date = date_tag.get_text(strip=True) if date_tag else "unknown"                    # article date
        body_tag = item.find(["encoded", "content", "summary", "description"])
        body = BeautifulSoup(body_tag.get_text(), "lxml").get_text("\n", strip=True) if body_tag else ""
        line, _ = save_page(folder, link, title, body, f"Site: {site}\nPublished: {date}\n")
        lines.append(line)
    return lines


def download_pdf(url, folder, session):
    """Download a PDF and save its text."""
    from io import BytesIO
    from pypdf import PdfReader                   # reads PDFs
    response = session.get(url, timeout=60)
    response.raise_for_status()
    pdf = PdfReader(BytesIO(response.content))    # open the PDF from memory
    text = ""
    for page in pdf.pages:                        # each page
        text += (page.extract_text() or "") + "\n"
    title = pdf.metadata.title if pdf.metadata and pdf.metadata.title else url
    line, _ = save_page(folder, url, title, text[:MAX_PAGE_CHARS], f"Pages: {len(pdf.pages)}\n")
    return line


def read_source_line(line):
    """Split a source line into its parts: follow?, URL, pages, match."""
    parts = line.split()                          # split on spaces
    job = {"follow": False, "url": None, "pages": None, "match": None}
    if parts and parts[0] == "follow":            # starts with 'follow'?
        job["follow"] = True
        parts = parts[1:]
    job["url"] = parts[0]                         # the URL
    for option in parts[1:]:                      # any options after it
        if option.startswith("pages="):           # e.g. pages=1-15
            first, last = option[6:].split("-")
            job["pages"] = (int(first), int(last))
        if option.startswith("match="):           # e.g. match=/courses/details/
            job["match"] = option[6:]
    return job


def fetch(topic, full=False):
    """Download every source into ~/llm-rag/docs/<topic>/ and write a hash manifest."""
    import requests                               # only needed online
    import socket                                 # low-level network settings
    from urllib import robotparser                # reads robots.txt (site rules for bots)
    from urllib.parse import urlparse
    socket.setdefaulttimeout(20)                  # never wait more than 20s for a site to answer

    folder = DOCS_DIR / topic                     # where the pages go
    folder.mkdir(parents=True, exist_ok=True)
    session = requests.Session()                  # reuse one connection
    session.headers["User-Agent"] = USER_AGENT    # say who we are
    manifest = []                                 # hash of every file saved
    done = set()                                  # URLs already downloaded
    robots = {}                                   # robots.txt rules per site

    def allowed(url):
        """Check the site's robots.txt says we may download this."""
        site = urlparse(url).scheme + "://" + urlparse(url).netloc
        if site not in robots:                    # first visit to this site?
            rules = robotparser.RobotFileParser(site + "/robots.txt")
            try:
                rules.read()
            except Exception:
                rules = None                      # no robots.txt = allowed
            robots[site] = rules
        return robots[site] is None or robots[site].can_fetch(USER_AGENT, url)

    def get(url, follow=False, match=None):
        """Download one URL. Returns (worked, text, links)."""
        if url in done:                           # already have it
            return True, "", []
        done.add(url)
        saved = folder / filename_for(url)        # where this page would be saved
        if saved.exists() and not follow and not is_feed(url):   # downloaded on an earlier run?
            manifest.append(f"{hashlib.sha256(saved.read_bytes()).hexdigest()}  {saved.name}")
            text = saved.read_text(encoding="utf-8", errors="ignore").split("\n\n", 2)[-1]
            print(f"{DIM}[=] already have {url}{RESET}")
            return True, text, []                 # skip it - makes a restart fast
        if not allowed(url):
            bad(f"robots.txt says no: {url}")
            return False, "", []
        try:
            if is_feed(url):
                manifest.extend(download_feed(url, folder, session))
                ok(f"feed {url}")
                return True, "", []
            if is_pdf(url):
                manifest.append(download_pdf(url, folder, session))
                ok(f"pdf  {url}")
                return True, "", []
            line, text, links = download_web_page(url, folder, session, follow, match)
            manifest.append(line)
            ok(f"page {url}" + (f"  {DIM}({len(links)} links to follow){RESET}" if follow else ""))
            return True, text, links
        except Exception as error:
            bad(f"failed {url}: {error}")
            return False, "", []
        finally:
            time.sleep(1)                         # be polite: one request a second

    source_list = FULL_SOURCES if full else SOURCES   # key sites, or the big list
    for source in source_list:                    # go through my source list
        job = read_source_line(source)
        if job["pages"]:                          # numbered pages, e.g. ?pg=1 ... ?pg=15
            first, last = job["pages"]
            urls = [job["url"].replace("{n}", str(n)) for n in range(first, last + 1)]
        else:
            urls = [job["url"]]
        last_text = None                          # to spot a site repeating its last page
        for url in urls:
            worked, text, links = get(url, job["follow"], job["match"])
            if job["pages"]:                      # run out of pages? stop early
                empty = len(text.strip()) < 200 or (job["follow"] and not links)
                if not worked or empty or text == last_text:
                    note(f"no more pages after {url}")
                    break
                last_text = text
            for link in links[:MAX_FOLLOW]:       # download the links we found
                get(link)

    (folder / "MANIFEST.sha256").write_text("\n".join(manifest) + "\n")  # save the fingerprints
    ok(f"{BOLD}{len(manifest)} files saved{RESET} in {folder}")


def check(topic):
    """Before cutting the network: how much did we get, and are any pages empty?"""
    folder = DOCS_DIR / topic
    files = sorted(folder.glob("*.md"))           # every saved page
    if not files:
        bad(f"nothing in {folder} - run: python3 rag_local_reduced.py fetch")
        return
    empty = []                                    # pages with almost no text
    total_chars = 0
    total_chunks = 0
    for f in files:
        text = f.read_text(encoding="utf-8", errors="ignore")
        body = text.split("\n\n", 1)[-1]          # skip the header
        total_chars += len(body)
        total_chunks += len(split_into_chunks(text))
        if len(body.strip()) < 400:               # probably a JavaScript-only or blocked page
            empty.append(f.name)
    print(f"\n{CYAN}{BOLD}Download check{RESET}")
    print(f"files        : {len(files)}")
    print(f"text         : {total_chars / 1_000_000:.1f} MB")
    print(f"chunks       : {total_chunks}  (each one gets embedded)")
    print(f"empty/thin   : {len(empty)}")
    for name in empty[:25]:
        print(f"   - {name}")


# =====================================================================
# MAKING IT SEARCHABLE (works offline - only needs Ollama on this machine)
# =====================================================================

def ingest(folder, topic):
    """Embed every downloaded page into the search database."""
    files = sorted(Path(folder).expanduser().glob("*.md"))     # every saved page
    files += sorted(Path(folder).expanduser().glob("*.txt"))   # plus any notes I add
    if not files:
        bad(f"no .md or .txt files in {folder}")
        return
    db = get_db()
    name = table_name(topic)
    if not db.collection_exists(name):            # first time? create the table
        size = len(embed("test"))                 # how many numbers the embedding model uses
        db.create_collection(name, vectors_config=VectorParams(size=size, distance=Distance.COSINE))

    start = time.time()
    total = 0
    for f in files:
        text = f.read_text(encoding="utf-8", errors="ignore")
        source = re.search(r"^Source:\s*(\S+)", text, re.M)   # where it came from
        source = source.group(1) if source else f.name
        title = re.search(r"^Title:\s*(.+)$", text, re.M)     # its title
        title = title.group(1).strip() if title else f.stem
        points = []
        for i, chunk in enumerate(split_into_chunks(text)):
            chunk = f"[{title}]\n{chunk}"         # label each chunk with its page title
            point_id = int(hashlib.sha256(f"{f}|{i}".encode()).hexdigest()[:15], 16)  # stable ID
            points.append(PointStruct(id=point_id, vector=embed(chunk),
                                      payload={"source": source, "chunk": chunk}))
        if points:
            db.upsert(name, points=points)        # save into the database
            total += len(points)
            ok(f"{f.name}: {len(points)} chunks")
    ok(f"{BOLD}{total} chunks{RESET} from {len(files)} files in {time.time() - start:.0f}s")


# =====================================================================
# STEP 2 - ASKING QUESTIONS (fully offline)
# =====================================================================

def search(question, topic):
    """Find the chunks of my data that best match the question."""
    db = get_db()
    name = table_name(topic)
    if not db.collection_exists(name):
        bad("nothing indexed yet - run: python3 rag_local_reduced.py build")
        return []
    vector = embed(question)                      # turn the question into numbers
    if hasattr(db, "query_points"):               # newer database library
        return db.query_points(name, query=vector, limit=RESULTS_PER_QUESTION, with_payload=True).points
    return db.search(name, query_vector=vector, limit=RESULTS_PER_QUESTION)  # older library


def answer(question, topic, use_data=True, model=None):
    """Ask the LLM. Yields ("token", text) as it types, then ("done", details)."""
    model = model or CHAT_MODEL
    hits = search(question, topic) if use_data else []   # find matching data (RAG)
    if use_data:
        context = ""
        for hit in hits:                          # glue the matching chunks together
            context += f"[{hit.payload['source']}]\n{hit.payload['chunk'][:CHARS_PER_RESULT]}\n\n"
        messages = [{"role": "system", "content": PROMPT_WITH_DATA},
                    {"role": "user", "content": f"QUESTION:\n{question}\n\nCONTEXT:\n{context}"}]
    else:                                         # no data: just the bare model
        messages = [{"role": "system", "content": PROMPT_NO_DATA},
                    {"role": "user", "content": question}]

    start = time.time()
    stream = ollama.chat(model=model, messages=messages, stream=True,
                         options={"num_predict": MAX_ANSWER_TOKENS, "num_ctx": CONTEXT_WINDOW})
    for part in stream:                           # the answer arrives word by word
        yield "token", part["message"]["content"]
    sources = []
    for hit in hits:                              # list each source once
        if hit.payload["source"] not in sources:
            sources.append(hit.payload["source"])
    yield "done", {"sources": sources, "secs": round(time.time() - start, 1), "model": model}


def ask(question, topic, use_data=True):
    """Ask one question in the terminal and print the answer as it's written."""
    mode = "with my data (RAG)" if use_data else "bare model, no data"
    print(f"{DIM}{CHAT_MODEL} · {mode}{RESET}\n")       # which model, and RAG on/off
    print(f"{GREEN}AI:{RESET} ", end="")                     # label the answer
    for kind, data in answer(question, topic, use_data):
        if kind == "token":
            print(data, end="", flush=True)                  # print each word straight away
        else:
            print(f"\n\n{DIM}answered in {data['secs']}s · nothing left this machine{RESET}")
            if data["sources"]:
                print(f"{CYAN}Sources:{RESET}")
                for source in data["sources"]:
                    print(f"{CYAN}  - {source}{RESET}")


def chat(topic):
    """Keep asking questions until I type q."""
    db = get_db()                                            # how much data is loaded
    name = table_name(topic)
    chunks = db.count(name).count if db.collection_exists(name) else 0
    line = "=" * 62
    print(f"\n{GREEN}{line}{RESET}")                         # banner for the big screen
    print(f"{BOLD}  AIR-GAPPED AI{RESET}  ·  UK uni computing, cyber & IT courses")
    print(f"  model {BOLD}{CHAT_MODEL}{RESET}  ·  {chunks} chunks of my data  ·  {GREEN}no internet{RESET}")
    print(f"{GREEN}{line}{RESET}")
    print(f"{DIM}  Type a question and press Enter.  q = quit{RESET}\n")
    while True:
        try:
            question = input(f"{BOLD}You:{RESET} ").strip()   # wait for a question
        except (EOFError, KeyboardInterrupt):                # Ctrl+C / Ctrl+D
            print()
            return
        if not question or question.lower() in ("q", "quit", "exit"):
            return
        print()
        ask(question, topic)
        print()


def info(topic):
    """Show which models and how much data are loaded."""
    db = get_db()
    name = table_name(topic)
    count = db.count(name).count if db.collection_exists(name) else 0
    print(f"\n{CYAN}{BOLD}Status{RESET}")
    print(f"chat model : {CHAT_MODEL}")
    print(f"embed model: {EMBED_MODEL}")
    print(f"database   : {DB_DIR}")
    print(f"topic      : {topic} ({count} chunks)")


def reset(topic):
    """Delete the search database for this topic (the downloaded files stay)."""
    db = get_db()
    name = table_name(topic)
    if db.collection_exists(name):
        db.delete_collection(name)
        ok(f"deleted {name}")


