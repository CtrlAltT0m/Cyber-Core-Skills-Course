def serve(topic, host, port):
    """Run the web page. Only one question at a time (it's one CPU and one database)."""
    import threading
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    lock = threading.Lock()                       # one question at a time

    def model_names():
        """List the chat models Ollama has (not the embedding model)."""
        names = []
        try:
            result = ollama.list()
            models = getattr(result, "models", None) or result.get("models", [])
            for m in models:
                name = getattr(m, "model", None) or m.get("name") or m.get("model")
                if name and "embed" not in name:
                    names.append(name)
        except Exception:
            pass
        return names or [CHAT_MODEL]

    class Handler(BaseHTTPRequestHandler):

        def send(self, code, content_type, body):
            """Send a reply to the browser."""
            self.send_response(code)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Content-Security-Policy", "default-src 'self' 'unsafe-inline'")  # no outside scripts
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.path == "/":                  # the page itself
                self.send(200, "text/html; charset=utf-8", WEB_PAGE.encode())
            elif self.path == "/api/info":        # models + how much data
                with lock:
                    db = get_db()
                    name = table_name(topic)
                    chunks = db.count(name).count if db.collection_exists(name) else 0
                details = {"chunks": chunks, "models": model_names(), "default_model": CHAT_MODEL}
                self.send(200, "application/json", json.dumps(details).encode())
            else:
                self.send(404, "text/plain", b"not found")

        def do_POST(self):
            if self.path != "/api/ask":
                return self.send(404, "text/plain", b"not found")
            try:
                length = int(self.headers.get("Content-Length", 0))
                request = json.loads(self.rfile.read(length) or b"{}")   # the question from the page
                question = str(request.get("question", "")).strip()[:2000]
            except Exception:
                return self.send(400, "text/plain", b"bad request")
            if not question:
                return self.send(400, "text/plain", b"empty question")
            model = request.get("model")
            if model not in model_names():        # only allow models we actually have
                model = CHAT_MODEL
            use_data = bool(request.get("rag", True))
            print(f"[web] {'RAG' if use_data else 'no RAG'} | {model} | {question}")
            self.send_response(200)
            self.send_header("Content-Type", "application/x-ndjson")   # one JSON message per line
            self.end_headers()
            try:
                with lock:
                    for kind, data in answer(question, topic, use_data, model):
                        message = {"t": data} if kind == "token" else {"done": data}
                        self.wfile.write((json.dumps(message) + "\n").encode())
                        self.wfile.flush()        # send each word straight away
            except (BrokenPipeError, ConnectionResetError):
                pass                              # browser closed - fine
            except Exception as error:
                self.wfile.write((json.dumps({"error": str(error)}) + "\n").encode())

        def log_message(self, *args):
            pass                                  # keep the terminal quiet

    if host not in ("127.0.0.1", "localhost"):
        bad(f"listening on {host} - only do this on an isolated host-only network")
    ok(f"web page on {BOLD}http://{host}:{port}{RESET}   (Ctrl+C to stop)")
    ThreadingHTTPServer((host, port), Handler).serve_forever()


