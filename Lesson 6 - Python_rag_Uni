_db = None                                   # the database connection (opened once)

def get_db():
    """Open the search database (only once - it allows one user at a time)."""
    global _db                               # use the variable above
    if _db is None:                          # not opened yet?
        DB_DIR.mkdir(parents=True, exist_ok=True)   # make the folder if needed
        _db = QdrantClient(path=str(DB_DIR))         # open it (stored on disk, no server)
    return _db                               # hand it back


def table_name(topic):
    """Turn a topic like 'unis' into a database table name like 'topic_unis'."""
    return "topic_" + re.sub(r"[^a-z0-9_]+", "_", topic.lower())  # only safe characters


def embed(text):
    """Turn text into a list of numbers that captures its meaning."""
    return ollama.embeddings(model=EMBED_MODEL, prompt=text)["embedding"]  # ask the embedding model


def split_into_chunks(text, size=900):
    """Cut text into ~900-character chunks, keeping whole lines (so table rows stay together)."""
    chunks = []                              # finished chunks
    current = ""                             # chunk being built
    for line in text.splitlines():           # go line by line
        line = line.strip()                  # tidy spaces
        if not line:                         # skip blank lines
            continue
        if current and len(current) + len(line) > size:   # chunk is full?
            chunks.append(current)           # save it
            current = ""                     # start a new one
        while len(line) > size:              # a single very long line? cut it up
            chunks.append(line[:size])
            line = line[size:]
        current = current + "\n" + line if current else line  # add the line
    if current:                              # anything left over?
        chunks.append(current)               # save it too
    return chunks


def filename_for(url):
    """Make a safe, unique file name from a URL."""
    name = re.sub(r"^https?://", "", url)                        # drop http(s)://
    name = re.sub(r"[^A-Za-z0-9]+", "_", name).strip("_")[:80]  # only safe characters
    short_hash = hashlib.sha256(url.encode()).hexdigest()[:8]   # makes it unique
    return f"{name}_{short_hash}.md"


def save_page(folder, url, title, text, extra=""):
    """Save one downloaded page as a text file with a header saying where it came from."""
    fetched = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")  # when we got it
    path = folder / filename_for(url)                                    # where to save it
    header = f"Source: {url}\nTitle: {title}\n{extra}Fetched: {fetched}\n\n"  # provenance header
    path.write_text(header + title + "\n\n" + text + "\n", encoding="utf-8")  # write the file
    file_hash = hashlib.sha256(path.read_bytes()).hexdigest()           # fingerprint it
    return f"{file_hash}  {path.name}", text                             # line for the manifest + the text


def is_feed(url):
    """Guess if a URL is an RSS / Atom news feed."""
    u = url.lower()
    return "rss" in u or "feed" in u or "atom" in u or u.endswith(".xml")


def is_pdf(url):
    """Is this a link to a PDF?"""
    return url.lower().split("?")[0].endswith(".pdf")


