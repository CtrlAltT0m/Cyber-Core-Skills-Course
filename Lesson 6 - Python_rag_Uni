def main():
    parser = argparse.ArgumentParser(description="Air-gapped AI for UK uni courses")
    commands = parser.add_subparsers(dest="command", required=True)

    def add(name, help_text):
        """Add a command that also takes --topic."""
        cmd = commands.add_parser(name, help=help_text)
        cmd.add_argument("--topic", default=TOPIC)
        return cmd

    add("build", "ONLINE: download the key sites, check them, make them searchable").add_argument(
        "--full", action="store_true", help="use the big source list instead (takes an hour+)")
    add("sources", "show the source list").add_argument("--full", action="store_true")
    add("fetch", "ONLINE: just download the sources").add_argument("--full", action="store_true")
    add("check", "check the download before cutting the network")
    add("ingest-dir", "make a folder of files searchable").add_argument("folder")
    a = add("ask", "ask one question")
    a.add_argument("question")
    a.add_argument("--no-rag", action="store_true", help="ask the bare model, without my data")
    add("chat", "ask question after question")
    s = add("serve", "start the web page")
    s.add_argument("--host", default="127.0.0.1")
    s.add_argument("--port", type=int, default=8080)
    add("info", "show models and how much data is loaded")
    add("reset", "delete the search database")

    args = parser.parse_args()

    if args.command == "build":                   # the whole of STEP 1 in one go
        fetch(args.topic, args.full)
        check(args.topic)
        ingest(DOCS_DIR / args.topic, args.topic)
        info(args.topic)
        print(); ok(f"{BOLD}ready{RESET} - cut the network, then: python3 rag_local_reduced.py chat")
    elif args.command == "sources":
        list_sources(args.full)
    elif args.command == "fetch":
        fetch(args.topic, args.full)
    elif args.command == "check":
        check(args.topic)
    elif args.command == "ingest-dir":
        ingest(args.folder, args.topic)
    elif args.command == "ask":
        ask(args.question, args.topic, use_data=not args.no_rag)
    elif args.command == "chat":
        chat(args.topic)
    elif args.command == "serve":
        serve(args.topic, args.host, args.port)
    elif args.command == "info":
        info(args.topic)
    elif args.command == "reset":
        reset(args.topic)


if __name__ == "__main__":
    try:
        main()
    finally:
        if _db is not None:                       # close the database cleanly on exit
            _db.close()                           # (stops a harmless warning at shutdown)
